{
  "name": "BARIN-ALP: Update Income",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "PUT",
        "path": "barin-alp/incomes/update",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-update-income",
      "name": "Webhook Update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "barin-incomes-update"
    },
    {
      "parameters": {
        "jsCode": "// Get sheetId from body or use default\nconst body = $('Webhook Update').first().json.body;\nconst sheetId = body.sheetId || '1Mvg9vxzp7LyYwNor0i8o8LvqYiF0ID4WD3Af58zkVTo';\nreturn [{ json: { sheetId } }];"
      },
      "id": "code-get-sheetid",
      "name": "Get SheetId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.sheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "INCOMES",
          "mode": "list",
          "cachedResultName": "INCOMES"
        },
        "options": {}
      },
      "id": "sheets-read-incomes",
      "name": "Read Incomes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [470, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst body = $('Webhook Update').first().json.body;\nconst targetId = Number(body.id);\n\n// Find row number (2-based because of header)\nlet rowNumber = null;\nfor (let i = 0; i < rows.length; i++) {\n  if (Number(rows[i].json.id) === targetId) {\n    rowNumber = i + 2; // +1 for 0-index, +1 for header\n    break;\n  }\n}\n\nif (!rowNumber) {\n  throw new Error(`Income with id ${targetId} not found`);\n}\n\nreturn [{\n  json: {\n    row_number: rowNumber,\n    id: targetId,\n    date: body.date || '',\n    amount: Number(body.amount) || 0,\n    description: body.description || '',\n    objectId: body.objectId ? Number(body.objectId) : '',\n    objectName: body.objectName || '',\n    createdBy: Number(body.createdBy) || 0,\n    createdByName: body.createdByName || '',\n    bankTransactionId: body.bankTransactionId ? Number(body.bankTransactionId) : ''\n  }\n}];"
      },
      "id": "code-find-row",
      "name": "Find Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Get SheetId').first().json.sheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "INCOMES",
          "mode": "list",
          "cachedResultName": "INCOMES"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "date": "={{ $json.date }}",
            "amount": "={{ $json.amount }}",
            "description": "={{ $json.description }}",
            "objectId": "={{ $json.objectId }}",
            "objectName": "={{ $json.objectName }}",
            "createdBy": "={{ $json.createdBy }}",
            "createdByName": "={{ $json.createdByName }}",
            "bankTransactionId": "={{ $json.bankTransactionId }}"
          },
          "matchingColumns": ["id"]
        },
        "options": {}
      },
      "id": "sheets-update-income",
      "name": "Update Income",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [910, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const income = $('Find Row').first().json;\ndelete income.row_number;\n\nreturn [{\n  json: {\n    success: true,\n    data: income\n  }\n}];"
      },
      "id": "code-format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "respond-update",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 300]
    }
  ],
  "connections": {
    "Webhook Update": {
