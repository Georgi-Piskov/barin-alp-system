{
  "name": "BARIN-ALP: Get Incomes",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "barin-alp/incomes",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-get-incomes",
      "name": "Webhook Get Incomes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "barin-incomes-get"
    },
    {
      "parameters": {
        "jsCode": "// Get sheetId from query params or use default\nconst query = $('Webhook Get Incomes').first().json.query || {};\nconst sheetId = query.sheetId || '1Mvg9vxzp7LyYwNor0i8o8LvqYiF0ID4WD3Af58zkVTo';\nreturn [{ json: { sheetId } }];"
      },
      "id": "code-get-sheetid",
      "name": "Get SheetId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [430, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.sheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "INCOMES",
          "mode": "list",
          "cachedResultName": "INCOMES"
        },
        "options": {}
      },
      "id": "sheets-read-incomes",
      "name": "Read Incomes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [470, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst incomes = rows.map(row => ({\n  id: Number(row.json.id),\n  date: row.json.date || '',\n  amount: Number(row.json.amount) || 0,\n  description: row.json.description || '',\n  objectId: row.json.objectId ? Number(row.json.objectId) : null,\n  objectName: row.json.objectName || null,\n  createdBy: Number(row.json.createdBy) || 0,\n  createdByName: row.json.createdByName || '',\n  bankTransactionId: row.json.bankTransactionId ? Number(row.json.bankTransactionId) : null\n}));\n\nreturn [{ json: { data: incomes } }];"
      },
      "id": "code-format-incomes",
      "name": "Format Incomes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "respond-incomes",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [910, 300]
    }
  ],
  "connections": {
    "Webhook Get Incomes": {
      "main": [
        [
          {
            "node": "Read Incomes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Incomes": {
      "main": [
        [
          {
