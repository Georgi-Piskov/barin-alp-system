        "jsCode": "const existingItems = $input.all();\nconst body = $('Webhook Create').first().json.body;\n\n// Calculate next ID\nlet maxId = 0;\nexistingItems.forEach(item => {\n  const id = Number(item.json.id);\n  if (id > maxId) maxId = id;\n});\nconst newId = maxId + 1;\n\n// Serialize photos to JSON string for Google Sheets\nconst photosJson = JSON.stringify(body.photos || []);\n\nreturn [{\n  json: {\n    id: newId,\n    name: body.name,\n    category: body.category || 'Р”СЂСѓРіРё',\n    status: body.status || 'available',\n    assignedTo: body.assignedTo || '',\n    assignedToName: body.assignedToName || '',\n    objectId: body.objectId || '',\n    objectName: body.objectName || '',\n    photos: photosJson\n  }\n}];"
