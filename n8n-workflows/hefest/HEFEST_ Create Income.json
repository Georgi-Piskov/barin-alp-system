    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst body = $('Webhook Create').first().json.body;\n\n// Generate new ID\nlet maxId = 0;\nfor (const row of rows) {\n  const id = Number(row.json.id) || 0;\n  if (id > maxId) maxId = id;\n}\nconst newId = maxId + 1;\n\nreturn [{\n  json: {\n    id: newId,\n    date: body.date || new Date().toISOString().split('T')[0],\n    amount: Number(body.amount) || 0,\n    description: body.description || '',\n    objectId: body.objectId ? Number(body.objectId) : '',\n    objectName: body.objectName || '',\n    createdBy: Number(body.createdBy) || 0,\n    createdByName: body.createdByName || '',\n    bankTransactionId: body.bankTransactionId ? Number(body.bankTransactionId) : ''\n  }\n}];"
      },
