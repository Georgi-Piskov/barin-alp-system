      "parameters": {
        "jsCode": "const objects = $input.all();\n\nconst formattedObjects = objects.map(obj => {\n  let techs = obj.json.assignedTechnicians;\n  let techArray = [];\n  \n  if (techs !== undefined && techs !== null && techs !== '') {\n    // РђРєРѕ Рµ С‡РёСЃР»Рѕ, РЅР°РїСЂР°РІРё РіРѕ РјР°СЃРёРІ СЃ РµРґРЅРѕ С‡РёСЃР»Рѕ\n    if (typeof techs === 'number') {\n      techArray = [techs];\n    } \n    // РђРєРѕ Рµ string, СЂР°Р·РґРµР»Рё РїРѕ Р·Р°РїРµС‚Р°СЏ\n    else if (typeof techs === 'string') {\n      techs = techs.replace(/[\\[\\]]/g, '').trim();\n      techArray = techs.split(',').map(Number).filter(n => !isNaN(n));\n    }\n    // РђРєРѕ РІРµС‡Рµ Рµ РјР°СЃРёРІ\n    else if (Array.isArray(techs)) {\n      techArray = techs;\n    }\n  }\n  \n  return {\n    id: Number(obj.json.ID),\n    name: obj.json.NAME,\n    address: obj.json.ADDRESS || '',\n    status: obj.json.STATUS || 'active',\n    totalExpenses: Number(obj.json.totalExpenses) || 0,\n    assignedTechnicians: techArray\n  };\n});\n\nreturn [{ json: { data: formattedObjects } }];"
      },
