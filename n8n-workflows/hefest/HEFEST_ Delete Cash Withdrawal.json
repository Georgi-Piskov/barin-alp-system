        "jsCode": "const rows = $input.all();\nconst body = $('Webhook Delete').first().json.body;\nconst targetId = Number(body.id);\n\nlet rowNumber = null;\nfor (let i = 0; i < rows.length; i++) {\n  if (Number(rows[i].json.id) === targetId) {\n    rowNumber = i + 2;\n    break;\n  }\n}\n\nif (!rowNumber) {\n  throw new Error(`Cash withdrawal with id ${targetId} not found`);\n}\n\nreturn [{\n  json: {\n    rowToDelete: rowNumber,\n    id: targetId\n  }\n}];"
