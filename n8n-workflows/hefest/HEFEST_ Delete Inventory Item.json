        "jsCode": "const items = $input.all();\nconst body = $('Webhook Delete').first().json.body;\nconst idToDelete = Number(body.id);\n\n// Find row number (1-indexed, +2 for header and 0-index)\nlet rowToDelete = -1;\nitems.forEach((item, index) => {\n  if (Number(item.json.id) === idToDelete) {\n    rowToDelete = index + 2; // +1 for header, +1 for 1-indexed\n  }\n});\n\nif (rowToDelete === -1) {\n  throw new Error('Item not found');\n}\n\nreturn [{ json: { rowNumber: rowToDelete, id: idToDelete } }];"
