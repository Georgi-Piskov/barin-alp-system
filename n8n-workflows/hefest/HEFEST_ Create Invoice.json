    {
      "parameters": {
        "jsCode": "const existingInvoices = $input.all();\nconst body = $('Webhook Create1').first().json.body;\n\n// Calculate next ID\nlet maxId = 0;\nexistingInvoices.forEach(inv => {\n  const id = Number(inv.json.id);\n  if (id > maxId) maxId = id;\n});\nconst newId = maxId + 1;\n\n// Serialize items to JSON string for Google Sheets\nconst itemsJson = JSON.stringify(body.items || []);\n\nreturn [{\n  json: {\n    id: newId,\n    date: body.date,\n    supplier: body.supplier,\n    invoiceNumber: body.invoiceNumber,\n    total: body.total || 0,\n    description: body.description || '',\n    createdBy: body.createdBy,\n    createdByName: body.createdByName,\n    objectId: body.objectId || '',\n    objectName: body.objectName || '',\n    items: itemsJson\n  }\n}];"
      },
