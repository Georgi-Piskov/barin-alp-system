      "parameters": {
        "jsCode": "const rows = $input.all();\nconst body = $('Webhook Delete').first().json.body;\nconst targetId = Number(body.id);\n\n// Find row number (2-based because of header)\nlet rowNumber = null;\nfor (let i = 0; i < rows.length; i++) {\n  if (Number(rows[i].json.id) === targetId) {\n    rowNumber = i + 2; // +1 for 0-index, +1 for header\n    break;\n  }\n}\n\nif (!rowNumber) {\n  throw new Error(`Income with id ${targetId} not found`);\n}\n\nreturn [{\n  json: {\n    row_number: rowNumber,\n    id: targetId\n  }\n}];"
      },
