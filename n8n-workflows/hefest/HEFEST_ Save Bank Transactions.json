      "parameters": {
        "jsCode": "// Get existing transactions and new transactions from request\nconst existingItems = $input.all();\nconst body = $('Webhook').first().json.body;\nconst newTransactions = body.transactions || [];\n\nif (!newTransactions.length) {\n  return [{ json: { success: true, insertedCount: 0, duplicateCount: 0, message: 'No transactions provided' } }];\n}\n\n// Create set of existing references for quick lookup\nconst existingRefs = new Set();\nlet maxId = 0;\n\nexistingItems.forEach(item => {\n  if (item.json.reference) {\n    existingRefs.add(String(item.json.reference));\n  }\n  const id = parseInt(item.json.id) || 0;\n  if (id > maxId) maxId = id;\n});\n\n// Filter out duplicates and assign IDs\nconst toInsert = [];\nlet duplicateCount = 0;\nconst importDate = new Date().toISOString().split('T')[0];\n\nnewTransactions.forEach(tx => {\n  const ref = String(tx.reference || '');\n  \n  if (ref && existingRefs.has(ref)) {\n    duplicateCount++;\n  } else {\n    maxId++;\n    toInsert.push({\n      id: maxId,\n      reference: tx.reference || '',\n      date: tx.date || '',\n      type: tx.type || 'debit',\n      amount: tx.amount || 0,\n      currency: tx.currency || 'BGN',\n      category: tx.category || 'other',\n      description: tx.description || '',\n      displayName: tx.displayName || '',\n      counterpartyName: tx.counterpartyName || '',\n      invoiceRef: tx.invoiceRef || '',\n      purpose: tx.purpose || '',\n      objectId: tx.objectId || '',\n      objectName: tx.objectName || '',\n      isCompanyExpense: tx.isCompanyExpense ? 'TRUE' : 'FALSE',\n      status: tx.status || 'unmatched',\n      importDate: importDate\n    });\n    // Add to set to prevent duplicates within same batch\n    if (ref) existingRefs.add(ref);\n  }\n});\n\n// Store counts for response\nconst insertCount = toInsert.length;\n\nif (toInsert.length === 0) {\n  return [{ json: { \n    success: true, \n    skip: true,\n    insertedCount: 0, \n    duplicateCount: duplicateCount,\n    message: `Р’СЃРёС‡РєРё ${duplicateCount} С‚СЂР°РЅР·Р°РєС†РёРё РІРµС‡Рµ СЃСЉС‰РµСЃС‚РІСѓРІР°С‚.`\n  } }];\n}\n\n// Return transactions with metadata\nreturn toInsert.map((tx, idx) => ({ \n  json: {\n    ...tx,\n    _meta: { insertCount, duplicateCount, isLast: idx === toInsert.length - 1 }\n  }\n}));"
      },
