    {
      "parameters": {
        "jsCode": "// Get query parameters\nconst userId = $('Webhook').item.json.query?.userId;\nconst technicianId = $('Webhook').item.json.query?.technicianId;\nconst objectId = $('Webhook').item.json.query?.objectId;\nconst type = $('Webhook').item.json.query?.type;\n\n// Get all transactions\nlet transactions = $input.all().map(item => item.json);\n\n// Filter by userId/technicianId if provided\nif (userId || technicianId) {\n  const filterUserId = userId || technicianId;\n  transactions = transactions.filter(t => \n    String(t.userId) === String(filterUserId)\n  );\n}\n\n// Filter by objectId if provided\nif (objectId) {\n  transactions = transactions.filter(t => \n    String(t.objectId) === String(objectId)\n  );\n}\n\n// Filter by type if provided\nif (type) {\n  transactions = transactions.filter(t => \n    t.type === type\n  );\n}\n\n// Sort by date descending (newest first)\ntransactions.sort((a, b) => {\n  const dateA = new Date(a.date || 0);\n  const dateB = new Date(b.date || 0);\n  return dateB - dateA;\n});\n\nreturn [{ json: { data: transactions } }];"
