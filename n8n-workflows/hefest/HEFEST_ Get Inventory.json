        "jsCode": "const rows = $input.all();\n\nconst items = rows.map(row => {\n  // Parse photos from JSON string\n  let photos = [];\n  if (row.json.photos) {\n    try {\n      photos = JSON.parse(row.json.photos);\n    } catch (e) {\n      // If not JSON, treat as comma-separated URLs\n      photos = row.json.photos.split(',').map(p => p.trim()).filter(p => p);\n    }\n  }\n  \n  return {\n    id: Number(row.json.id),\n    name: row.json.name || '',\n    category: row.json.category || 'Р”СЂСѓРіРё',\n    status: row.json.status || 'available',\n    assignedTo: row.json.assignedTo ? Number(row.json.assignedTo) : null,\n    assignedToName: row.json.assignedToName || null,\n    objectId: row.json.objectId ? Number(row.json.objectId) : null,\n    objectName: row.json.objectName || null,\n    photos: photos,\n    quantity: row.json.quantity ? Number(row.json.quantity) : 1\n  };\n});\n\nreturn [{ json: { data: items } }];"
