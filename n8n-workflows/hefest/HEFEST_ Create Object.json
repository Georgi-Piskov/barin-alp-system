      "parameters": {
        "jsCode": "const existingObjects = $input.all();\nconst body = $('Webhook Create').first().json.body;\n\n// Calculate next ID\nlet maxId = 0;\nexistingObjects.forEach(obj => {\n  const id = Number(obj.json.ID);\n  if (id > maxId) maxId = id;\n});\nconst newId = maxId + 1;\n\nreturn [{\n  json: {\n    ID: newId,\n    NAME: body.name,\n    ADDRESS: body.address,\n    STATUS: body.status || 'active',\n    totalExpenses: body.totalExpenses || 0,\n    assignedTechnicians: body.assignedTechnicians ? body.assignedTechnicians.join(',') : ''\n  }\n}];"
      },
