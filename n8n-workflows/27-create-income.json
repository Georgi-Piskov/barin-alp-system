{
  "name": "BARIN-ALP: Create Income",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "barin-alp/incomes/create",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-create-income",
      "name": "Webhook Create",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "barin-incomes-create"
    },
    {
      "parameters": {
        "jsCode": "// Get sheetId from body or use default\nconst body = $('Webhook Create').first().json.body;\nconst sheetId = body.sheetId || '1Mvg9vxzp7LyYwNor0i8o8LvqYiF0ID4WD3Af58zkVTo';\nreturn [{ json: { sheetId, ...body } }];"
      },
      "id": "code-get-sheetid",
      "name": "Get SheetId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [430, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.sheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "INCOMES",
          "mode": "list",
          "cachedResultName": "INCOMES"
        },
        "options": {}
      },
      "id": "sheets-read-for-id",
      "name": "Read For ID",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [470, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst body = $('Webhook Create').first().json.body;\n\n// Generate new ID\nlet maxId = 0;\nfor (const row of rows) {\n  const id = Number(row.json.id) || 0;\n  if (id > maxId) maxId = id;\n}\nconst newId = maxId + 1;\n\nreturn [{\n  json: {\n    id: newId,\n    date: body.date || new Date().toISOString().split('T')[0],\n    amount: Number(body.amount) || 0,\n    description: body.description || '',\n    objectId: body.objectId ? Number(body.objectId) : '',\n    objectName: body.objectName || '',\n    createdBy: Number(body.createdBy) || 0,\n    createdByName: body.createdByName || '',\n    bankTransactionId: body.bankTransactionId ? Number(body.bankTransactionId) : ''\n  }\n}];"
      },
      "id": "code-prepare-income",
      "name": "Prepare Income",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Get SheetId').first().json.sheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "INCOMES",
          "mode": "list",
          "cachedResultName": "INCOMES"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "date": "={{ $json.date }}",
            "amount": "={{ $json.amount }}",
            "description": "={{ $json.description }}",
            "objectId": "={{ $json.objectId }}",
            "objectName": "={{ $json.objectName }}",
            "createdBy": "={{ $json.createdBy }}",
            "createdByName": "={{ $json.createdByName }}",
            "bankTransactionId": "={{ $json.bankTransactionId }}"
          }
        },
        "options": {}
      },
      "id": "sheets-append-income",
      "name": "Append Income",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [910, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const income = $('Prepare Income').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    data: income\n  }\n}];"
      },
      "id": "code-format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "respond-create",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1350, 300]
    }
  ],
  "connections": {
    "Webhook Create": {
      "main": [
        [
          {
